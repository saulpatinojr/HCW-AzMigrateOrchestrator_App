# Azure Migration Orchestrator appliance — example environment. Copy to .env (git-ignored). Never put secrets here.
# Authentication uses managed identity or workload identity federation. Any variable ending in SECRET or PASSWORD makes the API refuse to start.
PORT=8081
AMO_LOG_SILENT=0

# Shared core and rule corpus come from the sibling _Addon checkout (ADR-0027). In the container image this is /srv/HCW-AzMigrateOrchestrator_Addon/rules.
AMO_RULES_DIR=../HCW-AzMigrateOrchestrator_Addon/rules

AMO_ENTRA_TENANT_ID=
AMO_ENTRA_CLIENT_ID=
AMO_ENTRA_AUDIENCE=
AMO_CREDENTIAL_KIND=managed-identity
AMO_DISCOVERY_FIXTURE=0

# Leave empty for the session-only in-memory repository (first release). Azure Database for PostgreSQL uses Entra token auth; password URLs are refused.
DATABASE_URL=
