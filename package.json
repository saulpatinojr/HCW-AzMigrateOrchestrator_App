{
  "name": "hcw-azmigrateorchestrator-app",
  "version": "0.1.0",
  "private": true,
  "description": "Azure Migration Orchestrator appliance — authenticated, read-only-by-default assessment of Azure estates (ADR-0027)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saulpatinojr/HCW-AzMigrateOrchestrator_App.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "addon:bootstrap": "bash scripts/bootstrap-addon.sh",
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:only": "node scripts/run-tests.mjs",
    "typecheck": "tsc -b tsconfig.build.json --dry",
    "web:build": "cd apps/appliance-web && npx tsc -p tsconfig.json && npx vite build",
    "appliance:api": "node apps/appliance-api/dist/server.js",
    "package": "bash scripts/package-repository.sh"
  },
  "dependencies": {
    "@amo/domain": "file:../HCW-AzMigrateOrchestrator_Addon/packages/domain",
    "@amo/contracts": "file:../HCW-AzMigrateOrchestrator_Addon/packages/contracts",
    "@amo/observability": "file:../HCW-AzMigrateOrchestrator_Addon/packages/observability",
    "@amo/csv-ingestion": "file:../HCW-AzMigrateOrchestrator_Addon/packages/csv-ingestion",
    "@amo/evidence-engine": "file:../HCW-AzMigrateOrchestrator_Addon/packages/evidence-engine",
    "@amo/dependency-graph": "file:../HCW-AzMigrateOrchestrator_Addon/packages/dependency-graph",
    "@amo/landing-zone": "file:../HCW-AzMigrateOrchestrator_Addon/packages/landing-zone",
    "@amo/classification-engine": "file:../HCW-AzMigrateOrchestrator_Addon/packages/classification-engine",
    "@amo/validation-engine": "file:../HCW-AzMigrateOrchestrator_Addon/packages/validation-engine",
    "@amo/report-engine": "file:../HCW-AzMigrateOrchestrator_Addon/packages/report-engine",
    "@amo/terraform-generator": "file:../HCW-AzMigrateOrchestrator_Addon/packages/terraform-generator",
    "@amo/runbook-generator": "file:../HCW-AzMigrateOrchestrator_Addon/packages/runbook-generator",
    "@amo/artifact-generator": "file:../HCW-AzMigrateOrchestrator_Addon/packages/artifact-generator",
    "@amo/authorization": "file:../HCW-AzMigrateOrchestrator_Addon/packages/authorization",
    "@amo/workspace-provider": "file:../HCW-AzMigrateOrchestrator_Addon/packages/workspace-provider",
    "@amo/azure-discovery": "file:../HCW-AzMigrateOrchestrator_Addon/packages/azure-discovery",
    "@amo/agents": "file:../HCW-AzMigrateOrchestrator_Addon/packages/agents",
    "@amo/ui": "file:../HCW-AzMigrateOrchestrator_Addon/packages/ui"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
